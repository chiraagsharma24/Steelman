# Mesh gateway (OpenAI-compatible AI router). Get this from your MeshAPI workspace.
MESH_API_KEY=rsk_your_key_here

# Optional — defaults to https://api.meshapi.ai if unset.
MESH_BASE_URL=https://api.meshapi.ai

# Neon Postgres connection string (app data only — no vectors are stored via Mesh;
# embeddings for retrieval are stored in our own `Chunk.embedding` pgvector column).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
