// Prisma schema for Steelman.
// Postgres (Neon) holds app data — documents, debates, verdicts, and chunk
// embeddings. The Mesh SDK (v0.1.0) has no `rag` namespace, so retrieval is
// built ourselves: embeddings.create() + pgvector, not Mesh-hosted RAG.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum SourceType {
  TEXT
  FILE
  URL
  YOUTUBE
}

enum DebateStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

enum VerdictLabel {
  SUPPORTED
  CONTESTED
  UNSUPPORTED
}

// --- Day 5: neutral claim classification + web-grounded fact-check ---

enum ClaimType {
  FACTUAL
  OPINION
  PREDICTION
  VALUE_JUDGMENT
}

enum FactVerdict {
  SUPPORTED
  MISLEADING
  FALSE
  UNVERIFIABLE
  NEEDS_CONTEXT
}

enum Grounding {
  WEB
  MODEL_KNOWLEDGE
}

enum Agreement {
  UNANIMOUS
  MAJORITY
  SPLIT
}

enum ClaimAnalysisStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model Document {
  id         String     @id @default(cuid())
  title      String
  sourceType SourceType
  rawText    String?
  meshFileId String?
  createdAt  DateTime   @default(now())

  debates   Debate[]
  chunks    Chunk[]
  analyses  Analysis[]
}

// NOTE: Chunk.embedding also has an HNSW index (vector_cosine_ops), added by
// hand in migrations/20260706042623_add_chunk_embedding_hnsw_index — Prisma
// has no way to declare vector index types in schema.prisma, so it isn't
// represented here. Consequence: `prisma migrate dev` (not --create-only)
// will propose a migration that DROPS that index, every time, because it
// sees it as drift. Always inspect a freshly generated migration for a
// stray `DROP INDEX "Chunk_embedding_hnsw_idx"` and delete that line before
// applying.
model Chunk {
  id         String                       @id @default(cuid())
  documentId String
  content    String
  chunkIndex Int
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Debate {
  id         String       @id @default(cuid())
  question   String
  status     DebateStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  documentId String?

  document Document? @relation(fields: [documentId], references: [id])
  verdicts Verdict[]
}

model Verdict {
  id              String       @id @default(cuid())
  debateId        String
  claim           String
  forArgument     String
  againstArgument String
  forWeakness     String
  againstWeakness String
  confidence      Confidence
  // Referee's overall call on the claim, plus its reasoning and summaries —
  // distinct from forArgument/againstArgument, which are each side's full
  // raw argument text.
  verdictLabel    VerdictLabel
  reasoning       String
  forSummary      String
  againstSummary  String
  // Full evidence chunks ({chunkId, content, score}) retrieved and handed to
  // both sides for this claim.
  evidenceJson    Json
  // Referee-cited subset ({chunkId, why}) — the evidence it actually leaned on.
  keyEvidenceJson Json
  createdAt       DateTime     @default(now())

  debate Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)
}

// Neutral claim-classification + web-grounded fact-check analysis (Day 5).
// Separate from Debate/Verdict (the two-sided for/against engine, still used
// on demand for genuinely contested individual claims) — this is a broader
// claim-by-claim credibility breakdown of an entire source.
model Analysis {
  id                String       @id @default(cuid())
  documentId        String?
  title             String
  status            DebateStatus @default(PENDING)
  // 0-100, see lib/analyze/score.ts for the documented formula.
  credibilityScore  Int?
  // % breakdown across FactVerdict categories, over checkable claims only.
  distributionJson  Json?
  // counts of each framing technique found across all claims.
  framingCountsJson Json?
  createdAt         DateTime     @default(now())

  document Document?       @relation(fields: [documentId], references: [id])
  claims   ClaimAnalysis[]
}

model ClaimAnalysis {
  id         String              @id @default(cuid())
  analysisId String
  claimText  String
  claimType  ClaimType
  checkable  Boolean
  // string[] of neutrally-named rhetorical/framing techniques, e.g.
  // "emotional language", "cherry-picking" — empty array is the default.
  framingJson Json
  status     ClaimAnalysisStatus
  error      String?

  // Position in the original classification order. The analysis pipeline
  // runs across many separate polled HTTP requests (one claim processed per
  // GET /api/analyze/[id] call, see lib/analyze/run.ts) instead of one long
  // request, so this is what lets a later poll pick up the next PENDING claim
  // in the right order and lets the final result be reassembled in order.
  sortIndex Int @default(0)
  // Only meaningful while checkable === true: whether this specific claim
  // was chosen (see WEB_VERIFY_LIMIT in lib/analyze/run.ts) to spend a real,
  // billable web search when it gets processed.
  webEligible Boolean @default(false)
  // Set when a poll atomically claims this row (PENDING -> PROCESSING).
  // Lets a later poll detect and recover a claim abandoned mid-work (e.g.
  // the serverless invocation that claimed it crashed or hit its own
  // timeout) instead of leaving the analysis stuck forever.
  processingStartedAt DateTime?

  // Populated only when checkable === true and status === DONE.
  factVerdict     FactVerdict?
  factConfidence  Confidence?
  factExplanation String?
  // [{title, url, snippet}] — real sources if grounding === WEB, else empty.
  sourcesJson     Json?
  correction      String?
  grounding       Grounding?

  // Multi-model cross-check: {verdicts: [{model, verdict}], agreement}.
  consensusJson Json?
  agreement     Agreement?

  createdAt DateTime @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([analysisId, sortIndex])
}
